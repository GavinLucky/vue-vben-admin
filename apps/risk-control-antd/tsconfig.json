{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@vben/tsconfig/web-app.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#/*": ["./src/*"]
    },
    "typeRoots": ["./src/**/types", "./src/**/typings", "@vben/types", "./src/types"]
  },
  "references": [{ "path": "./tsconfig.node.json" }],
  "include": ["./src/**/*.ts", "./src/**/*.tsx", "./src/**/*.vue"]
}
